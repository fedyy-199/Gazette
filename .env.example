# ==========================================
# Gazette Environment Variables Template
# Refer to AGENTS.md Section 21
# ==========================================

# Clerk Authentication (client + server)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Supabase Database & Persistence
# Obtain from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key MUST be kept secret (server only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Oxylabs Scraping & Scheduler (server only)
OXY_WSA_USERNAME=your_oxylabs_username
OXY_WSA_PASSWORD=your_oxylabs_password

# AI Provider for Article Analysis (Google AI Studio or OpenAI)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...

# Admin & Pipeline Security (server only)
GAZETTE_ADMIN_SECRET=your-secure-admin-secret-token
ANALYSIS_BATCH_SIZE=5

# Injected automatically by Vercel on deployment (do NOT add to .env.local)
# CRON_SECRET=
